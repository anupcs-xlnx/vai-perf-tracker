# Copy to perf-server.service and replace all /path/to/... placeholders.
# Choose any available port for --port.
[Unit]
Description=Perf Dashboard HTTP Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/artifacts/dashboard
ExecStart=/path/to/venv/bin/python \
    -m http.server --bind 0.0.0.0 <PORT>
Restart=always
RestartSec=5
StandardOutput=append:/path/to/logs/server.log
StandardError=append:/path/to/logs/server.log

[Install]
WantedBy=default.target
